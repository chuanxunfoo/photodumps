# Copy this file to ".env" in the same folder as package.json (project root).
# Values: Supabase Dashboard → Project Settings → API
# After saving, stop Metro completely and run: npx expo start -c

EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY

# Optional cloud fallback for Sticker Studio (remove.bg) if native ML fails.
# Primary cutout uses on-device AI (iOS Vision / Android ML Kit) after: npx expo prebuild && npx expo run:ios|android
EXPO_PUBLIC_REMOVE_BG_API_KEY=
