# Copy to app/.env (or project root per your setup). Restart Metro after changes.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY

# Supabase → Authentication → URL Configuration:
# Google Cloud → Credentials → OAuth Web client → Client ID (token exchange on server uses same pair)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=YOUR_GOOGLE_WEB_CLIENT_ID.apps.googleusercontent.com

# Option A (recommended on iPhone): iOS OAuth client (bundle com.yourname.dumpitapp) — no https redirect needed
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=YOUR_IOS_CLIENT_ID.apps.googleusercontent.com

# Optional override. Default (no Vercel): Supabase function below.
# EXPO_PUBLIC_GMAIL_OAUTH_REDIRECT_URI=https://ozuaijxdifqnbuavuelm.supabase.co/functions/v1/gmail-oauth-redirect

# Auth redirect (Supabase): dumpit://auth-callback
# Enable Email provider + Confirm email. Customize the confirmation email template in Authentication → Email Templates.

# Optional cloud fallback (remove.bg). On-device Vision cutout is free in dev/EAS builds.
EXPO_PUBLIC_REMOVE_BG_API_KEY=

# 0 = Expo Go only (npm start). Dev client: use npm run start:dev-client (sets 1 automatically).
EXPO_PUBLIC_NATIVE_CUTOUT=0

# iOS App Store subscriptions (NOT Stripe prod_/price_ IDs).
# App Store Connect → Subscriptions → each plan → Product ID
EXPO_PUBLIC_IOS_IAP_WEEKLY_PRODUCT_ID=com.yourname.dumpitapp.pro.weekly
EXPO_PUBLIC_IOS_IAP_MONTHLY_PRODUCT_ID=com.yourname.dumpitapp.pro.monthly
EXPO_PUBLIC_IOS_IAP_YEARLY_PRODUCT_ID=com.yourname.dumpitapp.pro.yearly
