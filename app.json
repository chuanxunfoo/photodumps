{
  "expo": {
    "name": "Dumplt",
    "slug": "Dumplt",
    "version": "1.0.0",
    "scheme": "dumplt",
    "plugins": [
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Dumplt to help you clean up your gallery!"
        }
      ],
      "react-native-compressor"
    ],
    "ios": {
      "bundleIdentifier": "com.yourname.dumpitapp",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Allow Dumplt to access photos.",
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": [
          "dumpit",
          "googlegmail",
          "instagram",
          "mailto"
        ],
        "NSPhotoLibraryAddUsageDescription": "photodumps saves your photo booth strips to your library when you tap Save."
      },
      "appleTeamId": "75356Q29L5",
      "supportsTablet": false,
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.yourname.dumpitapp.widgets"
        ]
      },
      "buildNumber": "62"
    },
    "android": {
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ],
      "package": "com.yourname.dumpitapp"
    },
    "extra": {
      "eas": {
        "projectId": "f1d3e77d-7a7e-4eab-aaf3-696b2acc42c8"
      }
    }
  }
}
